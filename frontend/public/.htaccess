# ----------------------------------------------------------------------
# Astittva Marketing Apache Configuration (.htaccess)
# Hostinger Static React SPA Deployment with XML Sitemap Delivery
# ----------------------------------------------------------------------

# 1. Correct MIME Types
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/xml .xml
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
</IfModule>

# 2. Character Encoding
AddDefaultCharset UTF-8

# 3. HTTP Security & Crawlability Headers
<IfModule mod_headers.c>
  # Cache control for sitemap and robots.txt
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
  </FilesMatch>

  # Allow search engines and social platforms to access preview images
  <FilesMatch "\.(png|jpg|jpeg|webp|ico|svg)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# 4. URL Rewriting & Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Directly serve physical sitemap.xml without SPA index.html fallback
  RewriteRule ^sitemap\.xml$ sitemap.xml [L]

  # Rewrite /api/sitemap.xml to /sitemap.xml directly
  RewriteRule ^api/sitemap\.xml$ sitemap.xml [L]

  # Serve existing physical files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Fallback: send all other route requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>
